# ---------------------------------------------------------------------------
# Unity — o projeto fica na raiz do repositório
# ---------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/.unity/

# Arquivos .meta DEVEM ser versionados (guardam GUIDs e import settings)
!/[Aa]ssets/**/*.meta

# Plugin autogerado do JetBrains Rider
/[Aa]ssets/Plugins/Editor/JetBrains*

# Addressables empacotados
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Arquivos de solução/projeto gerados pela Unity
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports / builds
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.app
*.x86_64
*.unitypackage

# Large model and map sources stay local; see CONTEXTO.md for map reinstallation.
/modelo-jogo/*.zip
# Large third-party map package stays local, like the original model archives.
/Packages/com.danielgruginski.medievalkit/

# Raw model geometry and source textures stay local, including FBX models.
/Assets/_Project/Art/Models/Characters/**/Source/**/*.fbx
/Assets/_Project/Art/Models/Characters/**/Source/**/*.FBX
/Assets/_Project/Art/Models/Characters/**/Source/**/*.png
/Assets/_Project/Art/Models/Characters/**/Source/**/*.tga
/Assets/_Project/Art/Models/Characters/**/Source/**/*.bmp

